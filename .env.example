# Copy to .env and adjust. Used by compose.yaml.
COURSES_DIR=/path/to/your/Courses   # where docs are written (mounted at /courses)
HOST_UID=1000                       # your user id:  id -u
HOST_GID=1000                       # your group id: id -g
TZ=Etc/UTC                          # schedule times use this timezone
LECTERN_PORT=8790                   # web UI: http://localhost:8790
COMPOSE_IGNORE_ORPHANS=true

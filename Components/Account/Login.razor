@page "/login"
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Authentication
@inject UserService Users
@inject NavigationManager Nav

<PageTitle>Sign in · Lectern</PageTitle>

<main class="auth">
    <div class="auth-card">
        <div class="auth-brand"><img src="icon.svg" alt="" width="28" height="28" /> Lectern</div>
        <h1>Sign in</h1>
        @if (Changed == "1") { <p class="good tiny">Password changed. Sign in with your new password.</p> }
        <EditForm Model="Input" method="post" OnValidSubmit="SignInAsync" FormName="login">
            <DataAnnotationsValidator />
            <label class="field"><span>Username</span><InputText @bind-Value="Input!.Username" autocomplete="username" autofocus /></label>
            <label class="field"><span>Password</span><InputText type="password" @bind-Value="Input!.Password" autocomplete="current-password" /></label>
            <label class="toggle"><InputCheckbox @bind-Value="Input!.Remember" /> Keep me signed in</label>
            @if (error is not null) { <p class="error tiny">@error</p> }
            <ValidationSummary class="error tiny" />
            <button class="btn primary wide" type="submit">Sign in</button>
        </EditForm>
    </div>
</main>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm(FormName = "login")] private LoginInput? Input { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "changed")] private string? Changed { get; set; }
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        if (HttpMethods.IsGet(HttpContext.Request.Method) && await Users.CountAsync() == 0) Nav.NavigateTo("setup");
    }

    private async Task SignInAsync()
    {
        var key = $"{Input!.Username.Trim().ToLowerInvariant()}|{HttpContext.Connection.RemoteIpAddress}";
        if (Users.IsLockedOut(key))
        {
            error = "Too many attempts. Try again in 15 minutes.";
            Input.Password = "";
            return;
        }
        var user = await Users.VerifyAsync(Input.Username, Input.Password, key);
        Input.Password = "";
        if (user is null) { error = "Wrong username or password."; return; }
        await HttpContext.SignInAsync(UserService.Principal(user), new AuthenticationProperties { IsPersistent = Input.Remember });
        Nav.NavigateTo(SafeReturnUrl, forceLoad: true);
    }

    /// <summary>Only paths on this site, never another host.</summary>
    private string SafeReturnUrl =>
        ReturnUrl is { Length: > 0 } r && r.StartsWith('/') && !r.StartsWith("//") && !r.StartsWith("/\\") ? r : "/";

    private sealed class LoginInput
    {
        [Required] public string Username { get; set; } = "";
        [Required] public string Password { get; set; } = "";
        public bool Remember { get; set; } = true;
    }
}

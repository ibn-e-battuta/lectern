@page "/"
@inject DocsService Docs
@inject DocReader Reader
@inject SyncRunner Runner
@inject SettingsService Settings
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Documents · Lectern</PageTitle>
<TopNav />

<main class="page">
    <div class="stats">
        <div class="stat"><b>@docs.Count</b><span>documents</span></div>
        <div class="stat"><b>@docs.Sum(d => d.Pages)</b><span>pages</span></div>
        <div class="stat"><b>@Format.Ago(docs.Select(d => d.LastSync).Max())</b><span>last sync</span></div>
        <div class="stat"><b>@(next is { } n ? Format.When(n) : "off")</b><span>next sync</span></div>
    </div>

    @if (message is not null) { <p class="notice">@message</p> }

    @if (!loaded) { }
    else if (docs.Count == 0)
    {
        <div class="card empty">
            <h2>No documents yet</h2>
            <p class="muted">Add a bitdocs share link and Lectern downloads it into your courses folder, then keeps it up to date.</p>
            <a class="btn primary" href="add">Add your first document</a>
        </div>
    }
    else
    {
        <div class="card">
            @foreach (var group in docs.GroupBy(d => d.Course))
            {
                <div class="group">@group.Key</div>
                @foreach (var d in group)
                {
                    <div class="doc">
                        <div class="doc-main">
                            <div class="doc-title">@d.Title</div>
                            <div class="muted tiny path">@d.Folder</div>
                            <div class="muted tiny">
                                @d.Pages pages · synced @Format.Ago(d.LastSync)
                                @if (d.Removed > 0) { <span> · @d.Removed removed online</span> }
                            </div>
                            @if (d.Doc.LastError is { } err) { <div class="error tiny">Last sync failed: @err</div> }
                            @if (moving == d.Doc.Guid)
                            {
                                <div class="row move">
                                    <input type="text" list="folders" @bind="moveTo" placeholder="Course Name/Docs" />
                                    <button class="btn primary small" @onclick="() => MoveAsync(d)">Move</button>
                                    <button class="btn ghost small" @onclick="() => moving = null">Cancel</button>
                                </div>
                            }
                        </div>
                        <div class="acts">
                            @if (d.FirstPage is { } first) { <a class="btn small" href="@($"read/{d.Doc.Guid}/{first}")">Read</a> }
                            @if (d.PdfFile is { } pdf) { <a class="btn small" href="@Reader.FileUrl(pdf)" target="_blank">PDF</a> }
                            <a class="btn small" href="@d.Doc.Url" target="_blank" rel="noopener">Online <Icon Name="external-link" Class="trailing" /></a>
                            <button class="btn small" disabled="@busy" @onclick="() => Sync(d)">Sync</button>
                            <button class="btn small" disabled="@(busy || d.State is null)" @onclick="() => RebuildPdf(d)">Rebuild PDF</button>
                            <button class="btn small" @onclick="() => StartMove(d)">Move</button>
                            <button class="btn small danger" @onclick="() => RemoveAsync(d)">Remove</button>
                        </div>
                    </div>
                }
            }
        </div>
    }
    <datalist id="folders">@foreach (var f in folders) { <option value="@f"></option> }</datalist>
</main>

@code {
    private List<DocInfo> docs = [];
    private List<string> folders = [];
    private DateTime? next;
    private bool loaded;
    private string? message;
    private string? moving;
    private string moveTo = "";

    private bool busy => Runner.Running is not null;

    protected override async Task OnInitializedAsync()
    {
        Docs.Changed += OnChanged;
        Runner.Changed += OnChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        docs = await Docs.InfoAsync();
        var s = await Settings.ScheduleAsync();
        next = s.Next(DateTime.Now, await Settings.LastScheduledRunAsync());
        loaded = true;
    }

    private void Sync(DocInfo d) =>
        message = Runner.TryStart([d.Doc.Guid], "manual", "Syncing one doc") == SyncStart.Started ? null : "Queued: it syncs when the current sync finishes.";

    private void RebuildPdf(DocInfo d) =>
        message = Runner.TryRebuildPdf(d.Doc.Guid) ? "Building the PDF… it appears in a minute." : "A sync is running; try again when it's done.";

    private void StartMove(DocInfo d)
    {
        moving = d.Doc.Guid;
        moveTo = d.Doc.Folder ?? d.Folder;
        if (folders.Count == 0) folders = Docs.FolderSuggestions();
    }

    private async Task MoveAsync(DocInfo d)
    {
        var err = await Docs.MoveAsync(d.Doc.Guid, moveTo);
        if (err is not null) { message = err; return; }
        moving = null;
        message = Runner.TryStart([d.Doc.Guid], "manual", "Moving files") == SyncStart.Started ? "Moving the files…" : "Saved. The files move when the current sync finishes.";
        await LoadAsync();
    }

    private async Task RemoveAsync(DocInfo d)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"Stop syncing “{d.Title}”?\n\nThe downloaded files stay where they are.")) return;
        await Docs.RemoveAsync(d.Doc.Guid);
        message = "Removed. The local files are kept.";
        await LoadAsync();
    }

    private void OnChanged() => InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    public void Dispose()
    {
        Docs.Changed -= OnChanged;
        Runner.Changed -= OnChanged;
    }
}

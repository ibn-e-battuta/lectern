<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <script>
        // Apply the saved theme before first paint.
        window.lecternTheme = {
            get() { try { return localStorage.getItem("lectern.theme") || "system"; } catch { return "system"; } },
            set(t) {
                try { t === "system" ? localStorage.removeItem("lectern.theme") : localStorage.setItem("lectern.theme", t); } catch {}
                if (t === "light" || t === "dark") document.documentElement.dataset.theme = t; else delete document.documentElement.dataset.theme;
            },
        };
        lecternTheme.set(lecternTheme.get());
    </script>
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="icon" href="favicon.ico" sizes="32x32" />
    <link rel="icon" href="icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="apple-touch-icon.png" />
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#c2581b" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    <Routes @rendermode="PageRenderMode" />
    <script src="_framework/blazor.web.js"></script>
    <script src="@Assets["app.js"]"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Sign-in pages render on the server (they set the cookie); everything else is interactive.
    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
